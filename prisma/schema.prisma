generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chat_members {
  chat_id      String   @db.Uuid
  user_id      String   @db.Uuid
  last_read_at DateTime @default(dbgenerated("to_timestamp((0)::double precision)")) @db.Timestamptz(6)
  joined_at    DateTime @default(now()) @db.Timestamptz(6)
  chats        chats    @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([chat_id, user_id])
  @@index([user_id], map: "idx_chat_members_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chats {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  chat_members chat_members[]
  messages     messages[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model messages {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id    String   @db.Uuid
  sender_id  String   @db.Uuid
  text       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  chats      chats    @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chat_id, created_at(sort: Desc)], map: "idx_messages_chat_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String
  phone         String?        @unique
  password_hash String?
  avatar_color  String         @default("#0EA5E9")
  status        String         @default("offline")
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  email         String?        @unique
  google_id     String?        @unique
  chat_members  chat_members[]
  messages      messages[]
}
